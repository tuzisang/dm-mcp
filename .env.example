# 达梦数据库 MCP 服务器环境变量配置示例

# 复制此文件为 .env 并根据实际情况修改配置

# 数据库连接配置
DM_HOST=your_host
DM_PORT=5236
DM_USER=your_user
DM_PASSWORD=your_password_here
DM_SCHEMA=your_schema

# 配置说明:
# DM_HOST: 达梦数据库服务器地址
# DM_PORT: 达梦数据库端口号（默认 5236）
# DM_USER: 数据库用户名（默认 SYSDBA）
# DM_PASSWORD: 数据库密码
# DM_SCHEMA: 默认数据库模式（可选）

# 使用方法:
# 1. 复制此文件为 .env
# 2. 修改上面的配置值
# 3. 启动服务器时会自动读取这些环境变量

# 或者通过命令行设置环境变量:
# export DM_HOST=your_host
# export DM_PORT=your_port
# export DM_USER=your_user
# export DM_PASSWORD=your_password
# export DM_SCHEMA=your_schema
# python main.py
